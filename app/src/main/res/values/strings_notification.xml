    <string name="notification_group_services_name">Services</string>
    <string name="notification_group_service_description">This group is used to allow us to notify you of our services and to allow us to do said background work.</string>

    <string name="notification_category_foreground_service_name">Bluetooth Alert Service</string>
    <string name="notification_category_foreground_service_description">The Alert Service is a Foreground Service Component that requires a notification to be present for the app to be in the \"foreground\", this is to listen for Bluetooth events.</string>

